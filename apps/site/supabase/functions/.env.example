# Copy to supabase/functions/.env for the local stack; in production these are the project's
# Edge Function secrets (DEPLOY.md). Both are secret.
PADDLE_ENVIRONMENT=sandbox
# Paddle → Developer tools → Notifications → the destination's secret key.
PADDLE_WEBHOOK_SECRET=
# Paddle → Developer tools → Authentication → an API key with customer portal session write.
PADDLE_API_KEY=
