# Copy to .env.local for `pnpm dev` and `pnpm build`. Every value is public: it ends up in the
# browser. See DEPLOY.md for where each comes from. Paddle's are needed only once billing is on.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key that `supabase status` prints.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
