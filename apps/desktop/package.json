{
  "name": "@video-editor/desktop",
  "version": "0.6.2",
  "productName": "Fineframe",
  "private": true,
  "description": "A fully automatic video editor",
  "license": "UNLICENSED",
  "author": "zcxy-dev",
  "homepage": "https://github.com/zcxy-dev/fineframe",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage.ts",
    "dist": "node scripts/stage.ts && electron-builder --publish never",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.ts'"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.17.0",
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
