{
  // The review page's script ships in the vebench wheel as plain JavaScript, with no build step,
  // so tsc checks the JavaScript itself, as strictly as the workspace's TypeScript.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/vebench/review_page"]
}
