{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/engine": { "entry": ["scripts/*.ts"] },
    "apps/site": {
      "entry": ["scripts/visual-screens.mjs"],
      "ignore": ["supabase/**"],
      "ignoreDependencies": [
        "@expo-google-fonts/noto-sans-sc",
        "@expo-google-fonts/noto-sans-tc",
        "@fontsource-variable/geist"
      ]
    }
  },
  "ignore": ["packages/schema/src/generated/**"],
  "ignoreBinaries": ["uv"]
}
